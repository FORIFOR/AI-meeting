  "transcript": [
    {
      "t": 4019,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 8046,
      "role": "user",
      "text": "こんにちは 。 今日 は よろしく お 願い し ます 。"
    },
    {
      "t": 11068,
      "role": "assistant",
      "text": "おっ、よろしく！今日は何話そうか。なんかおもしろいことあった？"
    },
    {
      "t": 16092,
      "role": "user",
      "text": "最近 、 仕事 で 新しい プロジェクト が 始まっ た ん です 。"
    },
    {
      "t": 19607,
      "role": "assistant",
      "text": "へえー、そうなんだ！どんなプロジェクトなの？"
    },
    {
      "t": 23643,
      "role": "user",
      "text": "週末は何をするのがおススメですか？"
    },
    {
      "t": 30692,
      "role": "assistant",
      "text": "うーん、天気が良ければ軽い散歩とかいい気分転換になるかも！インドア派なら、見たかった映画とかを一気に見るのもいいよね。普段どう過ごしてるの？"
    },
    {
      "t": 35725,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 し て しまっ て 落ち込ん で い ます 。"
    },
    {
      "t": 41268,
      "role": "assistant",
      "text": "そっか、大変だったね。まあ、誰にでもあることだし、あんまり気にしすぎないでね。美味しいものでも食べて、次に切り替えよ！何か話したいことある？"
    },
    {
      "t": 45790,
      "role": "user",
      "text": "でも 、 チーム の みんな が 助け て くれ まし た 。"
    },
    {
      "t": 46292,
      "role": "assistant",
      "text": "いいチームだね！ほんと、仲間がいる"
    },
    {
      "t": 46292,
      "role": "assistant",
      "text": "って心"
    },
    {
      "t": 50308,
      "role": "user",
      "text": "すみません、それはどういう意味ですか？"
    },
    {
      "t": 55337,
      "role": "assistant",
      "text": "あ、ごめん！みんなが助けてくれたなら、そのチームは素敵だねってこと！みんなで協力—"
    },
    {
      "t": 59360,
      "role": "user",
      "text": "あなた は 音楽 を 聴く の は 好き です か ?"
    },
    {
      "t": 63901,
      "role": "assistant",
      "text": "うん、音楽は好きだよ！いろんなジャンルを広く浅く聴く感じかな。どんな音楽が好きなの？"
    },
    {
      "t": 67929,
      "role": "user",
      "text": "私 は 最近 ランニング を 始め まし た 。"
    },
    {
      "t": 71969,
      "role": "assistant",
      "text": "へえー、すごいじゃん！どれくらいの距離走ってるの？"
    },
    {
      "t": 77509,
      "role": "user",
      "text": "英語の勉強を続けるコツがあれば教えてください。"
    },
    {
      "t": 81532,
      "role": "assistant",
      "text": "毎日少しずつでも続けることかな。好きな映画とか音楽を使って、楽しくやるのもいいかも！どんな、勉強してるの？"
    },
    {
      "t": 86569,
      "role": "user",
      "text": "今日 は 天気 が いい の で 散歩 に 行こう と 思い ます 。"
    },
    {
      "t": 87577,
      "role": "assistant",
      "text": "いいね！散歩日和だね。どこか行きたい場所"
    },
    {
      "t": 87577,
      "role": "assistant",
      "text": "とか"
    },
    {
      "t": 91599,
      "role": "user",
      "text": "あ 、 ごめん なさい 。 1 つ 聞い て も いい です か ?"
    },
    {
      "t": 93102,
      "role": "assistant",
      "text": "うん、何？"
    },
    {
      "t": 102155,
      "role": "user",
      "text": "面接 で 緊張 し ない ため に は どう すれ ば いい でしょう か ?"
    },
    {
      "t": 107696,
      "role": "assistant",
      "text": "準備をしっかりすると自信になるかも。あとは、深呼吸をして、いつもの自分で話すつもりで臨むとか！応援してるよ。"
    },
    {
      "t": 112729,
      "role": "user",
      "text": "先週 、 友人 と 京都 に 旅行 に 行き まし た 。"
    },
    {
      "t": 116256,
      "role": "assistant",
      "text": "へえ、京都いいな！どこか美味しいものとか観光地とか行った？"
    }
  ],
