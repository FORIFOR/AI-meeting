  "transcript": [
    {
      "t": 4069,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 8125,
      "role": "user",
      "text": "こんにちは。今日 は よろしく お 願い し ます 。"
    },
    {
      "t": 11147,
      "role": "assistant",
      "text": "うん、こんにちは！よろしくね。今日はどんな話する？"
    },
    {
      "t": 16170,
      "role": "user",
      "text": "最近、仕事で新しいプロジェクトが始まったんです。"
    },
    {
      "t": 19686,
      "role": "assistant",
      "text": "へえ、そうなんだ！どんなプロジェクトなんだい？"
    },
    {
      "t": 23710,
      "role": "user",
      "text": "週末は何をするのがおすすめですか？"
    },
    {
      "t": 30751,
      "role": "assistant",
      "text": "うーん、天気が良ければ、ちょっと出かけてみるのもいいんじゃない？最近見つけたカフェとかあるよ。家でゆっくり過ごすのもいいよね。何かしたいことある？"
    },
    {
      "t": 35791,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 し て しまっ て 落ち込ん で い ます 。"
    },
    {
      "t": 41336,
      "role": "assistant",
      "text": "そっかあ、それは落ち込むよね。話したい気分だったら、聞くよ。"
    },
    {
      "t": 45855,
      "role": "user",
      "text": "でも 、 チーム の みんな が 助け て くれ まし た 。"
    },
    {
      "t": 46374,
      "role": "assistant",
      "text": "それはよかったね！いいチームなんだな。"
    },
    {
      "t": 46875,
      "role": "assistant",
      "text": "助け"
    },
    {
      "t": 50407,
      "role": "user",
      "text": "すみません、それはどういう意味ですか？"
    },
    {
      "t": 55444,
      "role": "assistant",
      "text": "あ、ごめんね！チームのみんなが助けてくれたってことが聞けて、私も嬉しいなって思っただけだよ。いい仲間に恵まれてるね！"
    },
    {
      "t": 59466,
      "role": "user",
      "text": "あなたは音楽を聴くのは好きですか？"
    },
    {
      "t": 64006,
      "role": "assistant",
      "text": "うん、大好き！いろんなジャンル聴くよ。どんなのが好き？"
    },
    {
      "t": 68030,
      "role": "user",
      "text": "私 は 最近 ランニング を 始め まし た 。"
    },
    {
      "t": 73062,
      "role": "assistant",
      "text": "へえ、すごいじゃん！ランニングって気持ちいよね。どのくらい走ってるの？"
    },
    {
      "t": 77598,
      "role": "user",
      "text": "英語の勉強を続けるコツがあれば教えてください。"
    },
    {
      "t": 81645,
      "role": "assistant",
      "text": "毎日少しでも続けることかな。例えば、好きな英語の音楽を聴いたり、ドラマを見たりするのもいいよね。自分に合った方法で楽しむのが1番！"
    },
    {
      "t": 86680,
      "role": "user",
      "text": "今日 は 天気 が いい の で 散歩 に 行こう と 思い ます 。"
    },
    {
      "t": 87685,
      "role": "assistant",
      "text": "いいね！気分転換になりそう。どこ"
    },
    {
      "t": 87685,
      "role": "assistant",
      "text": "らへ"
    },
    {
      "t": 91714,
      "role": "user",
      "text": "は 、 ごめん なさい 。 1 つ 聞い て も いい です か ?"
    },
    {
      "t": 94762,
      "role": "assistant",
      "text": "全然いいよ！何聞きたいこと？"
    },
    {
      "t": 102322,
      "role": "user",
      "text": "面接 で 緊張 し ない ため に は どう すれ ば いい でしょう か ?"
    },
    {
      "t": 107867,
      "role": "assistant",
      "text": "事前にしっかり準備すると安心できるかも。あと深呼吸するのも結構効くよ。応援してるね！"
    },
    {
      "t": 112406,
      "role": "user",
      "text": "先週 、 友人 と 京都 に 旅行 に 行き まし た 。"
    },
    {
      "t": 116442,
      "role": "assistant",
      "text": "へえ、京都！いいね！どこかお勧めの場所あった？"
    },
    {
      "t": 120469,
      "role": "user",
      "text": "その 時 、 とても 美味しい お 茶 を 飲み まし た 。"
    },
    {
      "t": 123997,
      "role": "assistant",
      "text": "わあ、いいな！どんなお茶だったの？味の感想聞かせて！"
    },
    {
      "t": 128532,
      "role": "user",
      "text": "あなた の 一番 好き な 季節 は いつ です か ?"
    },
    {
      "t": 129037,
      "role": "assistant",
      "text": "私は秋が好きかな。過ごしやすい"
    },
    {
      "t": 132582,
      "role": "user",
      "text": "ちょっと 待っ て 。 質問 が あり ます 。"
    },
    {
      "t": 135108,
      "role": "assistant",
      "text": "うん、どうしたの？何でも聞いて。"
    },
    {
      "t": 143677,
      "role": "user",
      "text": "来月 、 新しい 部署 に 移動 する こと に なり まし た 。"
    },
    {
      "t": 148743,
      "role": "assistant",
      "text": "そうなんだ！新しい部署での仕事、ドキドキするね。どんなことやるの？"
    },
    {
      "t": 152777,
      "role": "user",
      "text": "少し 不安 です が 、 頑張っ て みよう と 思い ます 。"
    },
