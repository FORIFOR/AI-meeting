  "transcript": [
    {
      "t": 11041,
      "role": "user",
      "text": "こんにちは 。 今日 は よろしく お 願い し ます 。"
    },
    {
      "t": 12545,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 19594,
      "role": "user",
      "text": "最近 仕事 で 新しい プロジェクト が 始まっ た ん です 。"
    },
    {
      "t": 22608,
      "role": "assistant",
      "text": "へえ、そうなんだ！どんなプロジェクトなの？"
    },
    {
      "t": 28133,
      "role": "user",
      "text": "週末 は 何 を する の が お すすめ です か ?"
    },
    {
      "t": 32156,
      "role": "assistant",
      "text": "うーん、カフェでゆっくりするのもいいし、家で映画観るのもありだね。どんなことが好きかな?"
    },
    {
      "t": 39706,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 し て しまっ て 落ち込ん で い ます 。"
    },
    {
      "t": 42723,
      "role": "assistant",
      "text": "そっか、それは大変だったね。誰でも失敗はあるよ。"
    },
    {
      "t": 49281,
      "role": "user",
      "text": "で も チーム の みんな が 助け て くれ まし た 。"
    },
    {
      "t": 50787,
      "role": "assistant",
      "text": "いいチームだね。"
    },
    {
      "t": 57832,
      "role": "user",
      "text": "すみ ませ ん 。 それ は どう いう 意味 です か ?"
    },
    {
      "t": 60373,
      "role": "assistant",
      "text": "ああ、えっと、チーム"
    },
    {
      "t": 66932,
      "role": "user",
      "text": "あなた は 音楽 を 聞く の は 好き です か ?"
    },
    {
      "t": 68943,
      "role": "assistant",
      "text": "うん、好きだよ!最近どんな音楽聴いてるの?"
    },
    {
      "t": 73984,
      "role": "user",
      "text": "私 は 最近 ランニング を 始め まし た 。"
    },
    {
      "t": 78507,
      "role": "assistant",
      "text": "へえ、いいね!どんな感じ?"
    },
    {
      "t": 83523,
      "role": "user",
      "text": "英語 の 勉強 を 続ける コツ が あれ ば 教え て ください 。"
    },
    {
      "t": 88057,
      "role": "assistant",
      "text": "楽しいと思える方法を見つけるのが一番かも。"
    },
    {
      "t": 93078,
      "role": "user",
      "text": "今日 は 天気 が いい の で 散歩 に 行こう と 思い ます 。"
    },
    {
      "t": 94584,
      "role": "assistant",
      "text": "リフレッシュできそう。"
    },
    {
      "t": 100611,
      "role": "user",
      "text": "、 ごめん なさい 。 1 つ 聞い て も いい です か ?"
    },
    {
      "t": 115697,
      "role": "user",
      "text": "先週 友人 と 京都 に 旅行 に 行き まし た 。"
    },
    {
      "t": 117705,
      "role": "assistant",
      "text": "へえ、いいね! 京都どうだった? どこ行ったの?"
    },
    {
