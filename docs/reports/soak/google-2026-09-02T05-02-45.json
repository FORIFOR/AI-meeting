  "transcript": [
    {
      "t": 4017,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 8038,
      "role": "user",
      "text": "こんにちは。 今日はよろしくお願いします。"
    },
    {
      "t": 11052,
      "role": "assistant",
      "text": "あ、こんにちは！よろしくね。どうしたの？なんか話したいことある？"
    },
    {
      "t": 16074,
      "role": "user",
      "text": "最近、仕事で新しいプロジェクトが始まったんです。"
    },
    {
      "t": 19602,
      "role": "assistant",
      "text": "そうなんだ！新しいプロジェクト、大変そうだけど面白そう！どんな内容なの？"
    },
    {
      "t": 23646,
      "role": "user",
      "text": "週末は何をするのがおすすめですか？"
    },
    {
      "t": 30698,
      "role": "assistant",
      "text": "週末のおすすめかあ。天気がいいなら、外で過ごすのもいいかもね。散歩とか、ドライブとか。インドア派なら、映画観たり読書かな。どっちが好き？"
    },
    {
      "t": 35729,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 し て しまっ て 落ち込ん で い ます 。"
    },
    {
      "t": 41285,
      "role": "assistant",
      "text": "そっか、落ち込んじゃうよね。誰にでも失敗はあるしさ、あんまり気にしすぎないでね。次に活かせばいいんだよ。何か—話聞くよ。"
    },
    {
      "t": 45317,
      "role": "user",
      "text": "でも 、 チーム の みんな が 助け て くれ まし た 。"
    },
    {
      "t": 46323,
      "role": "assistant",
      "text": "チームのみんな、素敵だね！そういうよね。—\n支え"
    },
    {
      "t": 50370,
      "role": "user",
      "text": "すみません、それはどういう意味ですか？"
    },
    {
      "t": 55405,
      "role": "assistant",
      "text": "あ、ごめん！助けてくれたって聞いて、いい仲間だなって思っただけだよ。なんか温かいよね。"
    },
    {
      "t": 59419,
      "role": "user",
      "text": "あなたは音楽を聴くのは好きですか？"
    },
    {
      "t": 63938,
      "role": "assistant",
      "text": "音楽、大好きだよ！色んなジャンル聴くけど、最近は特にチルっぽい曲がお気に入り。どんな音楽聴くの？"
    },
    {
      "t": 67954,
      "role": "user",
      "text": "私 は 最近 ランニング を 始め まし た 。"
    },
    {
      "t": 72990,
      "role": "assistant",
      "text": "ランニング、いいね！体に良さそう。どのくらいの距離走ってるの？"
    },
    {
      "t": 77527,
      "role": "user",
      "text": "英語の勉強を続けるコツがあれば教えてください。"
    },
    {
      "t": 81554,
      "role": "assistant",
      "text": "楽しくやることかな。好きな映画とか音楽を使って勉強すると、意外と続くよ。あとは、小さな目標を少しずつ達成していくのもいいかも。何か試してることある？"
    },
    {
      "t": 86583,
      "role": "user",
      "text": "今日 は 天気 が いい の で 散歩 に 行こう と 思い ます 。"
    },
    {
      "t": 87586,
      "role": "assistant",
      "text": "いいね！散歩って気持ちいいよね。どこ"
    },
    {
      "t": 87586,
      "role": "assistant",
      "text": "行く"
    },
    {
      "t": 92120,
      "role": "user",
      "text": "は 、 ごめん なさい 。 1 つ 聞い て も いい です か ?"
    },
    {
      "t": 94134,
      "role": "assistant",
      "text": "いいよ、何？聞いて。"
    },
    {
      "t": 102199,
      "role": "user",
      "text": "面接 で 緊張 し ない ため に は どう すれ ば いい でしょう か ?"
    },
    {
      "t": 107739,
      "role": "assistant",
      "text": "事前の準備をしっかりして、あとは自分らしく話すだけって思えば、少しは気が楽になるんじゃないかな。深呼吸もいいよ。応援してるよ！"
    },
    {
      "t": 112766,
      "role": "user",
      "text": "先週 、 友人 と 京都 に 旅行 に 行き まし た 。"
    },
    {
      "t": 116290,
      "role": "assistant",
      "text": "京都！いいね。どこか特におすすめのスポットあった？"
    }
  ],
