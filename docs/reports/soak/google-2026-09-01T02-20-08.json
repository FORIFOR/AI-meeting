  "transcript": [
    {
      "t": 3534,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 8057,
      "role": "user",
      "text": "こんにちは。今日 は よろしく お 願い し ます 。"
    },
    {
      "t": 10572,
      "role": "assistant",
      "text": "あ、こんにちは！よろしくね。今日はどんな話する？"
    },
    {
      "t": 15616,
      "role": "user",
      "text": "最近 、 仕事 で 新しい プロジェクト が 始まっ た ん です 。"
    },
    {
      "t": 19144,
      "role": "assistant",
      "text": "へえ、新しく始まったんだ！どんなプロジェクトなの？"
    },
    {
      "t": 23181,
      "role": "user",
      "text": "週末は何をするのがおすすめですか？"
    },
    {
      "t": 30217,
      "role": "assistant",
      "text": "うーん、そうだな。天気が良かったら外に散歩に行くとか？家でゆっくり映画見るのもいいよね。何か気分転換になることしたい感じ？"
    },
    {
      "t": 35260,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 し て しまっ て 落ち込ん で い ます 。"
    },
    {
      "t": 41294,
      "role": "assistant",
      "text": "そうなんだ、落ち込んじゃうよね。あんまり気にしすぎないで、美味しいものでも食べて元気出してね。何か話したいことある？"
    },
    {
      "t": 45326,
      "role": "user",
      "text": "でも 、 チーム の みんな が 助け て くれ まし た 。"
    },
    {
      "t": 45830,
      "role": "assistant",
      "text": "それ、素敵だね！いいチームだな。みんな"
    },
    {
      "t": 50362,
      "role": "user",
      "text": "「 すみません 、 それ は どう いう 意味 です か ? 」"
    },
    {
      "t": 54908,
      "role": "assistant",
      "text": "あ、ごめん！チームの人が助けてくれるのは、すごいいい関係だね、ってこと！心強いね。"
    },
    {
      "t": 58925,
      "role": "user",
      "text": "あなた は 音楽 を 聞く の は 好き です か ?"
    },
    {
      "t": 63462,
      "role": "assistant",
      "text": "うん、好きだよ！いろんなジャンルを気分で聴く感じ。どんな音楽聴くの？"
    },
    {
      "t": 67495,
      "role": "user",
      "text": "私 は 最近 ランニング を 始め まし た 。"
    },
    {
      "t": 72527,
      "role": "assistant",
      "text": "へえ、ランニング始めたんだ！いいね、体調とか変わった感じある？"
    },
    {
      "t": 77072,
      "role": "user",
      "text": "英語の勉強を続けるコツがあれば教えてください。"
    },
    {
      "t": 81097,
      "role": "assistant",
      "text": "やっぱり、楽しむことかな？好きな映画とか音楽を使って勉強すると長続きするよ。あとは、毎日ちょっとずつやるのも大事！何か目標とかあるの？"
    },
    {
      "t": 86131,
      "role": "user",
      "text": "今日 は 天気 が いい の で 散歩 に 行こう と 思い ます 。"
    },
    {
      "t": 87135,
      "role": "assistant",
      "text": "いいね！散歩でいい気分転換になるといいね。"
    },
    {
      "t": 91668,
      "role": "user",
      "text": "あ 、 ごめん なさい 。 1 つ 聞い て も いい です か ?"
    },
    {
      "t": 93181,
      "role": "assistant",
      "text": "全然いいよ！何？"
    },
    {
      "t": 101765,
      "role": "user",
      "text": "面接 で 緊張 し ない ため に は どう すれ ば いい でしょう か ?"
    },
    {
      "t": 107315,
      "role": "assistant",
      "text": "面接の前に、深呼吸するといいかも。あとは、事前に練習しておくと、気持ちが落ち着くよ。どう、できそう？"
    },
    {
      "t": 112361,
      "role": "user",
      "text": "先週 、 友人 と 京都 に 旅行 に 行き まし た 。"
    },
    {
      "t": 115875,
      "role": "assistant",
      "text": "へえ、京都に行ったんだ！どこかおすすめの場所とかあった？"
    },
    {
      "t": 119889,
      "role": "user",
      "text": "その時、とても美味しいお茶を飲みました。"
    },
    {
      "t": 123414,
      "role": "assistant",
      "text": "いいなあ、美味しいお茶！どんなお茶だったの？"
    },
    {
      "t": 127959,
      "role": "user",
      "text": "あなた の 一番 好き な 季節 は いつ です か ?"
    },
    {
      "t": 128462,
      "role": "assistant",
      "text": "うーん、春かな。暖かくなっ"
    },
    {
      "t": 132011,
      "role": "user",
      "text": "ちょっと 待っ て 、 質問 が あり ます 。"
    },
    {
      "t": 133519,
      "role": "assistant",
      "text": "お、なんだい？"
    },
    {
      "t": 143115,
      "role": "user",
      "text": "来月 、 新しい 部署 に 移動 する こと に なり まし た 。"
    },
    {
      "t": 148166,
      "role": "assistant",
      "text": "そうなんだ！新しい部署でも頑張ってね！何の部署に移動するの？"
    },
    {
      "t": 152186,
      "role": "user",
      "text": "少し 不安 です が 、 頑張っ て みよう と 思い ます 。"
    },
    {
      "t": 156209,
      "role": "assistant",
      "text": "その気持ち大事だね！きっとうまくいくよ。何か大変なことがあったらいつでも聞くからね。"
    },
    {
      "t": 161242,
      "role": "user",
      "text": "プレゼン の 準備 で 何 から 始めれ ば いい か 迷っ て い ます 。"
    },
    {
