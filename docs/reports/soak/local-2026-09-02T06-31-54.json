  "timeline": {
    "seconds": 301.49047916666666,
    "timeline": [
      {
        "index": 0,
        "startSec": 3,
        "endSec": 6.292458333333333,
        "text": "こんにちは。今日はよろしくお願いします。",
        "kind": "turn"
      },
      {
        "index": 1,
        "startSec": 10.339270833333334,
        "endSec": 14.468458333333333,
        "text": "最近、仕事で新しいプロジェクトが始まったんです。",
        "kind": "turn"
      },
      {
        "index": 2,
        "startSec": 18.716291666666667,
        "endSec": 21.8181875,
        "text": "週末は何をするのがおすすめですか？",
        "kind": "turn"
      },
      {
        "index": 3,
        "startSec": 29.7258125,
        "endSec": 33.9229375,
        "text": "実は昨日、少し失敗してしまって落ち込んでいます。",
        "kind": "turn"
      },
      {
        "index": 4,
        "startSec": 40.7190625,
        "endSec": 43.63552083333333,
        "text": "でも、チームのみんなが助けてくれました。",
        "kind": "turn"
      },
      {
        "index": 5,
        "startSec": 45.63552083333333,
        "endSec": 48.512708333333336,
        "text": "すみません、それはどういう意味ですか？",
        "kind": "barge_in"
      },
      {
        "index": 6,
        "startSec": 54.598479166666664,
        "endSec": 57.385416666666664,
        "text": "あなたは音楽を聴くのは好きですか？",
        "kind": "turn"
      },
      {
        "index": 7,
        "startSec": 63.0075,
        "endSec": 66.1655,
        "text": "私は最近、ランニングを始めました。",
        "kind": "turn"
      },
      {
        "index": 8,
        "startSec": 72.0304375,
        "endSec": 75.79872916666666,
        "text": "英語の勉強を続けるコツがあれば教えてください。",
        "kind": "turn"
      },
      {
        "index": 9,
        "startSec": 80.7584375,
        "endSec": 84.71208333333334,
        "text": "今日は天気がいいので、散歩に行こうと思います。",
        "kind": "turn"
      },
      {
        "index": 10,
        "startSec": 86.71208333333334,
        "endSec": 89.731125,
        "text": "あ、ごめんなさい、一つ聞いてもいいですか？",
        "kind": "barge_in"
      },
      {
        "index": 11,
        "startSec": 95.9444375,
        "endSec": 100.20129166666666,
        "text": "面接で緊張しないためには、どうすればいいでしょうか。",
        "kind": "turn"
      },
      {
        "index": 12,
        "startSec": 107.12058333333333,
        "endSec": 110.6569375,
        "text": "先週、友人と京都に旅行に行きました。",
        "kind": "turn"
      },
      {
        "index": 13,
        "startSec": 115.68820833333334,
        "endSec": 118.67889583333333,
        "text": "そのとき、とても美味しいお茶を飲みました。",
        "kind": "turn"
      },
      {
        "index": 14,
        "startSec": 123.3026875,
        "endSec": 126.3218125,
        "text": "あなたの一番好きな季節はいつですか？",
        "kind": "turn"
      },
      {
        "index": 15,
        "startSec": 128.3218125,
        "endSec": 130.67377083333332,
        "text": "ちょっと待って、質問があります。",
        "kind": "barge_in"
      },
      {
        "index": 16,
        "startSec": 137.730125,
        "endSec": 141.55264583333334,
        "text": "来月、新しい部署に異動することになりました。",
        "kind": "turn"
      },
      {
        "index": 17,
        "startSec": 147.62625,
        "endSec": 151.0015625,
        "text": "少し不安ですが、頑張ってみようと思います。",
        "kind": "turn"
      },
      {
        "index": 18,
        "startSec": 155.79010416666668,
        "endSec": 159.7595625,
        "text": "プレゼンの準備で何から始めればいいか迷っています。",
        "kind": "turn"
      },
      {
        "index": 19,
        "startSec": 165.23139583333332,
        "endSec": 168.14072916666666,
        "text": "昨日の夜は、映画を見て過ごしました。",
        "kind": "turn"
      },
      {
        "index": 20,
        "startSec": 170.14072916666666,
        "endSec": 173.01791666666668,
        "text": "すみません、それはどういう意味ですか？",
        "kind": "barge_in"
      },
      {
        "index": 21,
        "startSec": 178.19089583333334,
        "endSec": 180.77927083333333,
        "text": "おすすめの本があれば教えてください。",
        "kind": "turn"
      },
      {
        "index": 22,
        "startSec": 186.91822916666666,
        "endSec": 190.699125,
        "text": "最近、睡眠時間が短くて疲れやすいです。",
        "kind": "turn"
      },
      {
        "index": 23,
        "startSec": 195.8844375,
        "endSec": 199.095,
        "text": "コーヒーと紅茶なら、どちらが好きですか？",
        "kind": "turn"
      },
      {
        "index": 24,
        "startSec": 207.00679166666666,
        "endSec": 210.571125,
        "text": "私は三年前にこの会社に入りました。",
        "kind": "turn"
      },
      {
        "index": 25,
        "startSec": 212.571125,
        "endSec": 215.59016666666668,
        "text": "あ、ごめんなさい、一つ聞いてもいいですか？",
        "kind": "barge_in"
      },
      {
        "index": 26,
        "startSec": 220.58029166666665,
        "endSec": 223.86522916666667,
        "text": "今の目標は、チームリーダーになることです。",
        "kind": "turn"
      },
      {
        "index": 27,
        "startSec": 231.37635416666666,
        "endSec": 234.19897916666667,
        "text": "ところで、あなたは何が得意ですか？",
        "kind": "turn"
      },
      {
        "index": 28,
        "startSec": 238.96214583333332,
        "endSec": 242.73002083333333,
        "text": "今日はここまでにしましょう。ありがとうございました。",
        "kind": "turn"
      },
      {
        "index": 29,
        "startSec": 247.30464583333332,
        "endSec": 250.59710416666667,
        "text": "こんにちは。今日はよろしくお願いします。",
        "kind": "turn"
      },
      {
        "index": 30,
        "startSec": 252.59710416666667,
        "endSec": 254.9490625,
        "text": "ちょっと待って、質問があります。",
        "kind": "barge_in"
      },
      {
        "index": 31,
        "startSec": 259.56764583333336,
        "endSec": 263.69683333333336,
        "text": "最近、仕事で新しいプロジェクトが始まったんです。",
        "kind": "turn"
      },
      {
        "index": 32,
        "startSec": 268.8606458333333,
        "endSec": 271.96254166666665,
        "text": "週末は何をするのがおすすめですか？",
        "kind": "turn"
      },
      {
        "index": 33,
        "startSec": 278.15414583333336,
        "endSec": 282.35127083333333,
        "text": "実は昨日、少し失敗してしまって落ち込んでいます。",
        "kind": "turn"
      },
