  "transcript": [
    {
      "t": 4026,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 7582,
      "role": "user",
      "text": "こんにちは、今日は よろし くお 願い し ます。"
    },
    {
      "t": 11094,
      "role": "assistant",
      "text": "こんにちは！こちらこそ、今日はよろしくね。"
    },
    {
      "t": 16147,
      "role": "user",
      "text": "最近、仕事 で 新しい プロジェクト が 始まっ たん です。"
    },
    {
      "t": 19668,
      "role": "assistant",
      "text": "へえ、新しいプロジェクトなんだ！"
    },
    {
      "t": 23199,
      "role": "user",
      "text": "週末は何 をする の がおすすめで すか？"
    },
    {
      "t": 30254,
      "role": "assistant",
      "text": "週末かあ、いいよね。私はのんびり映画観るのが好きなんだけど、何か観たい気分とかある？"
    },
    {
      "t": 35306,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 して しま って 落ち 込 んで、います。"
    },
    {
      "t": 41337,
      "role": "assistant",
      "text": "そうだったんだ、それはどんよりしちゃうね。何かあったら聞くよ、話せそうなら教えてくれる？"
    },
    {
      "t": 44858,
      "role": "user",
      "text": "で も、チーム のみん なが 助け て くれ ま した。"
    },
    {
      "t": 49901,
      "role": "user",
      "text": "すみません、それ は どういう 意味 ですか？"
    },
    {
      "t": 55424,
      "role": "assistant",
      "text": "あ、ごめんね！チームのみんなが助けてくれるなんて、いい関係なんだなーって思ったんだ。"
    },
    {
      "t": 58436,
      "role": "user",
      "text": "あなたは音楽を聴くのは好きですか？"
    },
    {
      "t": 63960,
      "role": "assistant",
      "text": "大好きだよ！作業中とか、ついつい聴いちゃうんだよね。最近よく聴く曲とかある？"
    },
    {
      "t": 67487,
      "role": "user",
      "text": "私 は 最近 ランニング を 始め ま した。"
    },
    {
      "t": 73029,
      "role": "assistant",
      "text": "へえ、ランニング始めたんだ！走ってるときってどんな曲聴くの？"
    },
    {
      "t": 77556,
      "role": "user",
      "text": "英語 の 勉強 を 続ける コツ が あれ ば 教え て ください。"
    },
    {
      "t": 81585,
      "role": "assistant",
      "text": "英語の勉強かあ、すごいね！私は好きな洋楽の歌詞を書き出したりしてたけど、何か興味あるジャンルとかある？"
    },
    {
      "t": 86125,
      "role": "user",
      "text": "今日は天気 がいい の で、散歩に行こうと思います。"
    },
    {
      "t": 87630,
      "role": "assistant",
      "text": "お、いい天気だね！"
    },
    {
      "t": 91165,
      "role": "user",
      "text": "あ、ごめんなさい、一つ聞いてもいいですか？"
    },
    {
      "t": 95192,
      "role": "assistant",
      "text": "もちろん！何でも聞いて。"
    },
    {
      "t": 101759,
      "role": "user",
      "text": "面接 で 緊張 しな いため に は ど うすれ ばいい でしょうか。"
    },
    {
      "t": 107822,
      "role": "assistant",
      "text": "面接かあ、緊張するよね。私は深呼吸をゆっくり繰り返すと少し落ち着くんだけど、何か自分なりのリラックス方法ってある？"
    },
    {
      "t": 112378,
      "role": "user",
      "text": "先週、友人 と 京都 に 旅行 に 行き ま した。"
    },
    {
      "t": 116398,
      "role": "assistant",
      "text": "わあ、京都！いいなー。どこか特においしいもの食べた？"
    },
    {
      "t": 119944,
      "role": "user",
      "text": "その 時、とても 美味し いお茶 を 飲み ま した。"
    },
    {
      "t": 123987,
      "role": "assistant",
      "text": "へえ、京都でお茶かあ、贅沢だね！"
    },
    {
      "t": 127515,
      "role": "user",
      "text": "あなたの一番好きな季節はいつですか？"
    },
    {
      "t": 129023,
      "role": "assistant",
      "text": "私はやっぱり春かなあ。"
    },
    {
      "t": 132049,
      "role": "user",
      "text": "ちょっと 待 って 質問 が あり ます。"
    },
    {
      "t": 136073,
      "role": "assistant",
      "text": "うん、待ってるよ。何かな？"
    },
    {
      "t": 143112,
      "role": "user",
      "text": "来月、新しい 部署 に 移動 する ことに なり ま した。"
    },
    {
      "t": 148172,
      "role": "assistant",
      "text": "えっ、そうなの！おめでとう！新しい環境って少しドキドキするよね？"
    },
    {
      "t": 152206,
      "role": "user",
      "text": "少し 不安 です が、頑張 って みよ うと 思 います。"
    },
    {
      "t": 156728,
      "role": "assistant",
      "text": "その前向きな気持ち、すごく素敵だよ。"
    },
    {
      "t": 161288,
      "role": "user",
      "text": "プレゼンの準備で何から始めれ ばいいか迷っています。"
    },
    {
      "t": 166323,
      "role": "assistant",
      "text": "それは悩みどころだよね。まずは構成案をざっくり書き出すところから始めてみる？"
    },
    {
      "t": 169840,
      "role": "user",
      "text": "昨日 の 夜 は 映画 を 見 て 過ごし ま した。"
    },
    {
      "t": 170845,
      "role": "assistant",
      "text": "へえ、いいなあ！"
    },
    {
      "t": 174401,
      "role": "user",
      "text": "すみません、それ は どういう 意味 で すか？"
    },
    {
      "t": 178918,
      "role": "assistant",
      "text": "あ、ごめん！話が急に飛んじゃったね。昨日見た映画のこと、気になっちゃって。"
    },
    {
      "t": 182438,
      "role": "user",
      "text": "お すすめ の 本 が あれ ば 教え て ください。"
    },
    {
      "t": 187498,
      "role": "assistant",
      "text": "本かぁ、最近だとエッセイとか読みやすいよ。何か気になってるジャンルってある？"
    },
    {
      "t": 192019,
      "role": "user",
      "text": "最近、睡眠 時間 が 短く て 疲れ やすい です。"
    },
    {
      "t": 196547,
      "role": "assistant",
      "text": "それは大変だね、体調大丈夫？寝る前にスマホを置いてゆっくりする時間とか作れてる？"
    },
    {
      "t": 200567,
      "role": "user",
      "text": "コーヒーと紅茶ならどちらが好きですか？"
    },
    {
      "t": 207633,
      "role": "assistant",
      "text": "私は断然コーヒー派かな。あの香りを嗅ぐとホッとするんだよね。どっちが好き？"
    },
    {
      "t": 211663,
      "role": "user",
      "text": "私 は 3 年前 に この 会社 に 入り ま した。"
    },
    {
      "t": 221219,
      "role": "assistant",
      "text": "うん、もちろんだよ。なあに？"
    },
    {
      "t": 225248,
      "role": "user",
      "text": "今 の 目標 は チーム リーダー に なる こと です。"
    },
    {
      "t": 231292,
      "role": "assistant",
      "text": "おお、かっこいいね！\nリーダーになったら、どんなチームを作りたいの？"
    },
    {
      "t": 235328,
      "role": "user",
      "text": "ところで、あなたは何が得意ですか？"
    },
    {
      "t": 239854,
      "role": "assistant",
      "text": "私はね、こうやって誰かとおしゃべりするのが一番好きかな。"
    },
    {
      "t": 244380,
      "role": "user",
      "text": "今日はここ まで にし ましょう ありがとう ござい ま した。"
    },
    {
      "t": 248414,
      "role": "assistant",
      "text": "わかった！話せて楽しかったよ。またいつでも気軽に声かけてね、お疲れ様！"
    },
    {
