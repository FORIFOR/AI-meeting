      "t": 4542,
      "role": "assistant",
      "text": "おつかれー！最近どう？なんかあった？"
    },
    {
      "t": 10093,
      "role": "user",
      "text": "こんにちは 。 今日 は よろしく お 願い し ます 。"
    },
    {
      "t": 11099,
      "role": "assistant",
      "text": "よろしく！なんか最近どう？"
    },
    {
      "t": 18129,
      "role": "user",
      "text": "最近 仕事 で 新しい プロジェクト が 始まっ た ん です 。"
    },
    {
      "t": 19642,
      "role": "assistant",
      "text": "へえ、そうなんだ！新しい"
    },
    {
      "t": 20645,
      "role": "assistant",
      "text": "プロジェクトって結構気合"
    },
    {
      "t": 26701,
      "role": "user",
      "text": "週末 は 何 を する の が お すすめ です か"
    },
    {
      "t": 30738,
      "role": "assistant",
      "text": "大変そうだけど、楽しそうだね。どんなことやるの？"
    },
    {
      "t": 38299,
      "role": "user",
      "text": "実 は 昨日 少し 失敗 し て しまっ て 落ち込ん で い ます 。"
    },
    {
      "t": 41323,
      "role": "assistant",
      "text": "ええ、そうなんだ...。それは落ち込むよね。"
    },
    {
      "t": 47379,
      "role": "user",
      "text": "で も チーム の みんな が 助け て くれ まし た 。"
    },
    {
      "t": 47880,
      "role": "assistant",
      "text": "チームの人"
    },
    {
      "t": 53424,
      "role": "user",
      "text": "すみ ませ ん 。 それ は どう いう 意味 です か ?"
    },
    {
      "t": 55453,
      "role": "assistant",
      "text": "ううん、チームワークがすごくいいんだなって思って。"
    },
    {
      "t": 56463,
      "role": "assistant",
      "text": "雰囲気どうなの?"
    },
    {
      "t": 64015,
      "role": "user",
