# services/token-broker — never commit real keys
PORT=8787
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_PLAN_MODEL=gpt-4.1-mini
OPENAI_EVAL_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_EVAL_MODEL=gemini-2.5-flash
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=

# Recall.ai meeting bots (P0-1). Region: us-east-1 | us-west-2 | eu-central-1 | ap-northeast-1
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Public https URL of this broker (e.g. https://xxxx.ngrok-free.app) — Recall must reach /api/meeting/recall/relay/
RECALL_PUBLIC_URL=
# Public URL of the web app (the bot streams this page as its camera + audio)
RECALL_BOT_PAGE_URL=
# Workspace verification secret (whsec_…) — signs dashboard webhooks, realtime endpoints and callbacks.
# Fetched through the Recall MCP credential flow; never paste it anywhere else.
RECALL_WEBHOOK_VERIFICATION_SECRET=
# Language for post-meeting (async) transcription; "auto" lets Recall detect it.
RECALL_TRANSCRIPT_LANGUAGE=auto
# Override the durable meeting/queue directory (defaults to services/token-broker/data)
RECALL_DATA_DIR=
# Meeting session tokens (Round 3 Gate 5): HMAC secret ≥16 chars. Unset → ephemeral secret (tokens die on restart).
MEETING_TOKEN_SECRET=

# Container deployments: 0.0.0.0; local development: 127.0.0.1
HOST=127.0.0.1

# Use the API origin of your hosted or self-hosted Attendee instance
ATTENDEE_API_BASE_URL=https://app.attendee.dev

# API key issued by that same Attendee instance
ATTENDEE_API_KEY=

# Webhook signing secret configured in Attendee
ATTENDEE_WEBHOOK_SECRET=

# Vertex AI: ADC locally, runtime service account on Cloud Run.
GEMINI_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_LIVE_MODEL=gemini-live-2.5-flash-native-audio
